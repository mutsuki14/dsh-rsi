{
  "name": "dsh-rsi",
  "version": "0.1.0",
  "description": "Recursive self-improvement for DeepSeek Harness: Actor-owned experience memory, an independent Verifier Agent, and Curriculum-driven broad/deep exploration, after RSIAgent.",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mutsuki14/dsh-rsi.git"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "self-improvement",
    "agent-memory",
    "verifier"
  ],
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./engine": {
      "types": "./lib/engine/index.d.ts",
      "default": "./lib/engine/index.js"
    },
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "locale/*.json",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "LICENSE",
    "NOTICE",
    "docs"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "node": "^22.19 || >=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepare": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "check": "pnpm run typecheck && pnpm run test",
    "e2e": "bash scripts/e2e-headless.sh"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.4",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5-alpha.1",
    "@deepseek-ai/dsh-agent": ">=0.2.1-alpha.2 <0.3.0",
    "@deepseek-ai/dsh-brand": ">=0.2.1-alpha.2 <0.3.0",
    "@deepseek-ai/dsh-commands": ">=0.2.1-alpha.2 <0.3.0",
    "@deepseek-ai/dsh-llm": ">=0.2.1-alpha.2 <0.3.0",
    "@deepseek-ai/dsh-session": ">=0.2.1-alpha.2 <0.3.0",
    "@deepseek-ai/dsh-session-projection": ">=0.2.1-alpha.2 <0.3.0",
    "@deepseek-ai/dsh-subagent": ">=0.2.1-alpha.2 <0.3.0",
    "@deepseek-ai/dsh-system-prompt": ">=0.2.1-alpha.2 <0.3.0",
    "@deepseek-ai/dsh-tools": ">=0.2.1-alpha.2 <0.3.0",
    "@deepseek-ai/dsh-working-directory": ">=0.2.1-alpha.2 <0.3.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-commands": {
      "optional": true
    },
    "@deepseek-ai/dsh-working-directory": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5-alpha.1",
    "@deepseek-ai/dsh-agent": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-agent-loop": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-agent-loop-testkit": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-bash-sandbox": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-brand": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-commands": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-fs-local": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-fs-sandbox": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-llm": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-sandbox-local": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-sandbox-policy": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-session": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-session-persistence-jsonl": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-session-projection": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-shell-env": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-subagent": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-subagent-spawn-in-process": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-subprocess-local": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-system-prompt": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-tool-bash": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-tool-fs": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-tools": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-user-approval": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-working-directory": "0.2.1-alpha.2",
    "@types/node": "^22.20.5",
    "typescript": "~5.9.3",
    "vitest": "^3.2.7"
  }
}
